# Copy this file to .env and replace every value. NEVER commit .env.
# Use letters and numbers only in passwords (they are placed inside DATABASE_URL).

# development or production
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=orbit

# --- Backend ---
# Used when running the backend on your machine (outside Docker). Docker overrides it automatically.
DATABASE_URL=postgresql+psycopg://orbit:change_me_dev_only@localhost:5432/orbit
# Sent by clients/n8n in the X-API-Key header
API_KEY=change_me_dev_api_key
# Reserved for login/session signing
SECRET_KEY=change_me_long_random_value
# Comma-separated dashboard origins
CORS_ORIGINS=http://localhost:3000

# --- n8n ---
N8N_URL=http://localhost:5678
# Encrypts credentials stored inside n8n
N8N_ENCRYPTION_KEY=change_me_random_string

# --- AI model provider (leave empty until needed) ---
LLM_API_KEY=
